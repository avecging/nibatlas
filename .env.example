# Browser-safe Supabase configuration. Values are supplied per environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe MapTiler key. Restrict it by allowed origins in MapTiler.
# Leave empty to use the offline demo basemap.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional. URL of a served copy of maplibre-gl/dist/maplibre-gl-worker.mjs.
# Required before any tiled basemap can render under the Turbopack build.
# See docs/adr/0002-maplibre-worker.md.
NEXT_PUBLIC_MAPLIBRE_WORKER_URL=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by local OpenNext preview only.
NEXTJS_ENV=development
