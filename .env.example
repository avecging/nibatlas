# Browser-safe Supabase configuration. Values are supplied per environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe MapTiler key. Restrict it by allowed origins in MapTiler.
# Leave empty to use the offline demo basemap.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional override. Builds serve the matching MapLibre worker and shared module
# at /maplibre/ by default. See docs/adr/0002-maplibre-worker.md.
NEXT_PUBLIC_MAPLIBRE_WORKER_URL=

# Browser-safe Cloudflare Turnstile site key, for the contribution forms.
# Leave empty locally: no widget renders, and the route skips verification
# outside production. A production build refuses submissions without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Contribution intake. See docs/runbooks/contribution-intake.md.
# Set as Cloudflare Worker secrets in deployed environments, never in a build.
CONTRIBUTE_SCRIPT_URL=
CONTRIBUTE_SHARED_SECRET=
TURNSTILE_SECRET_KEY=

# Used by local OpenNext preview only.
NEXTJS_ENV=development
