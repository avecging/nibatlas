{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibatlas-staging-isolated",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 1000
  },
  "env": {
    "production": {
      "name": "nibatlas-production",
      "vars": {
        "MEDIA_ENV": "staging"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "nibatlas-staging-images"
        }
      ],
      "images": {
        "binding": "PHOTO_IMAGES"
      }
    },
    "staging": {
      "name": "nibatlas-staging-isolated",
      "vars": {
        "MEDIA_ENV": "staging"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "nibatlas-staging-isolated-images"
        }
      ],
      "images": {
        "binding": "PHOTO_IMAGES"
      }
    }
  },
  "vars": {
    "MEDIA_ENV": "staging"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "nibatlas-staging-isolated-images"
    }
  ],
  "images": {
    "binding": "PHOTO_IMAGES"
  }
}
