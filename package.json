{
  "name": "nibatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepreview:cloudflare": "node ./scripts/copy-maplibre-worker.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "prebuild:cloudflare": "node ./scripts/copy-maplibre-worker.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "predeploy:staging": "node ./scripts/copy-maplibre-worker.mjs",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "predeploy:production": "node ./scripts/copy-maplibre-worker.mjs",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "maplibre-gl": "^6.4.0",
    "next": "16.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.9",
    "wrangler": "4.123.0"
  },
  "packageManager": "pnpm@11.19.0"
}
